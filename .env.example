# 1) Neon connection string (Neon dashboard > Connect). Use the "pooled" one.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Optional: the "direct" (non-pooled) Neon link. Used only by `npm run db:push`.
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# 2) Your login PIN (numbers only is easiest). Changing it logs out every device.
APP_PIN="4821"

# 3) Any long random text. Keeps the login cookie safe.
AUTH_SECRET="change-this-to-any-long-random-text-1234567890"

# 4) Printed on memos (optional)
SHOP_NAME="My Shop"
SHOP_PHONE="01XXXXXXXXX"
SHOP_ADDRESS="Chattogram"
